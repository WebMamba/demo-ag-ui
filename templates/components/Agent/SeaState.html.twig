<div class="agent-component agent-component-sea rounded-2xl border border-sky-200 dark:border-sky-800 shadow-sm my-3 p-4 bg-gradient-to-br from-sky-50 to-white dark:from-sky-950 dark:to-slate-800">
    {% if error %}
        <div class="text-sm text-red-600">
            <span class="font-medium">{{ 'sea.unavailable'|trans }}</span> — {{ error }}
        </div>
    {% else %}
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-xs uppercase tracking-wide text-sky-700 dark:text-sky-400">{{ 'sea.title'|trans }}</div>
                <div class="text-lg font-semibold text-slate-900 dark:text-slate-100">{{ placeName ?: (latitude|number_format(2) ~ ', ' ~ longitude|number_format(2)) }}</div>
            </div>
            {% if this.beaufort is not null %}
                <div class="text-right">
                    <div class="text-3xl font-bold text-slate-900 dark:text-slate-100">F{{ this.beaufort }}</div>
                    <div class="text-[11px] text-slate-500">Beaufort</div>
                </div>
            {% endif %}
        </div>

        <div class="mt-3 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl bg-white/70 dark:bg-slate-900/40 p-2">
                <div class="text-xl">💨</div>
                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ windSpeed is not null ? windSpeed|number_format(0) ~ ' kn' : '—' }}</div>
                <div class="text-[11px] text-slate-500">{{ this.compass(windDirection) }}{% if windGusts is not null %} · {{ 'sea.gusts'|trans }} {{ windGusts|number_format(0) }}{% endif %}</div>
            </div>
            <div class="rounded-xl bg-white/70 dark:bg-slate-900/40 p-2">
                <div class="text-xl">🌊</div>
                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ waveHeight is not null ? waveHeight|number_format(1) ~ ' m' : '—' }}</div>
                <div class="text-[11px] text-slate-500">{{ this.compass(waveDirection) }}{% if wavePeriod is not null %} · {{ wavePeriod|number_format(0) }}s{% endif %}</div>
            </div>
            <div class="rounded-xl bg-white/70 dark:bg-slate-900/40 p-2">
                <div class="text-xl">〰️</div>
                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ swellHeight is not null ? swellHeight|number_format(1) ~ ' m' : '—' }}</div>
                <div class="text-[11px] text-slate-500">{{ 'sea.swell'|trans }} {{ this.compass(swellDirection) }}{% if swellPeriod is not null %} · {{ swellPeriod|number_format(0) }}s{% endif %}</div>
            </div>
        </div>

        <div class="mt-3 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
            <span>{{ this.verdict }}</span>
            {% if seaTemperature is not null %}<span>🌡️ {{ seaTemperature|number_format(0) }}°C</span>{% endif %}
        </div>
    {% endif %}
</div>
