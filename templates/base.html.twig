<!DOCTYPE html>
<html lang="{{ ui_locale() }}" class="h-full {{ ui_theme_classes() }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Passage Agent — AG-UI demo{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.15em%22 font-size=%22108%22>⛵</text></svg>">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {# The effect controllers listen on the document, so they live on the shell rather
       than inside the chat: an effect outlives the message that requested it. #}
    <body
        class="{% block body_class %}h-full{% endblock %}"
        data-controller="theme locale"
    >
        {% block body %}{% endblock %}
    </body>
</html>
