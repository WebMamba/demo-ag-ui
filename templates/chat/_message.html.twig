{% if role == 'user' %}
    <div class="flex justify-end">
        <div class="max-w-[85%] rounded-2xl rounded-br-md bg-indigo-600 text-white px-4 py-2 text-sm whitespace-pre-wrap">{{ content }}</div>
    </div>
{% else %}
    <div class="flex gap-3">
        <div class="shrink-0 w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center">⛵</div>
        <div class="min-w-0 max-w-[85%] assistant-text text-sm">{{ content|markdown_to_html }}</div>
    </div>
{% endif %}
