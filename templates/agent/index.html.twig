{% extends 'base.html.twig' %}

{% block title %}Passage Agent — AG-UI demo{% endblock %}

{# A column, so the shell takes what the viewport leaves: in dev, the web debug
   toolbar appends a spacer below it, and must not cover the console's input. #}
{% block body_class %}h-full flex flex-col{% endblock %}

{% block body %}
{# A chart plotter, not a chat. Two columns: the instruments and the chart, which
   scroll, and beside them the navigator's console — typed to, or talked to — always
   in full view. #}
<div class="flex-1 min-h-0 w-full flex flex-col">
    {{ include('agent/_chrome.html.twig') }}

    <main class="flex-1 min-h-0 flex gap-3 p-3">
        {# The AG-UI shared state, rendered by a Live Component. #}
        <twig:PassagePanel id="passage-panel" class="flex-1 min-w-0" />

        {# The AG-UI client is the bundle's ag-ui controller; agent-chat only renders what
           it dispatches. agent-chat comes first, to be listening when ag-ui connects. #}
        <div
            data-controller="agent-chat ag-ui"
            data-ag-ui-endpoint-value="{{ path('agent_stream') }}"
            data-agent-chat-waiting-value="{{ 'chat.waiting'|trans }}"
            data-agent-chat-thinking-value="{{ 'chat.thinking'|trans }}"
            data-agent-chat-thought-value="{{ 'chat.thought'|trans }}"
            data-action="
                ag-ui:connect->agent-chat#connected
                ag-ui:run-started->agent-chat#runStarted
                ag-ui:run-finished->agent-chat#runFinished
                ag-ui:run-error->agent-chat#runError
                ag-ui:error->agent-chat#error
                ag-ui:idle->agent-chat#idle
                ag-ui:text-message-start->agent-chat#textStart
                ag-ui:text-message-content->agent-chat#textContent
                ag-ui:text-message-end->agent-chat#textEnd
                ag-ui:reasoning-start->agent-chat#reasoningStart
                ag-ui:reasoning-message-content->agent-chat#reasoningContent
                ag-ui:reasoning-end->agent-chat#reasoningEnd
                ag-ui:tool-call-start->agent-chat#toolCallStart
                ag-ui:tool-call-end->agent-chat#toolCallEnd
                ag-ui:activity-changed->agent-chat#activityChanged
                ag-ui:state-changed->agent-chat#stateChanged
                ag-ui:custom->agent-chat#custom
                passage:changed@document->ag-ui#setState
                passage:edited@document->agent-chat#edited
                agent-chat:edited->ag-ui#send
            "
            class="mfd-panel w-[340px] xl:w-[420px] shrink-0 flex flex-col overflow-hidden"
        >
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-200 dark:border-slate-800">
                <div class="mfd-label !mb-0">🧭 {{ 'console.title'|trans }}</div>
                <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" data-agent-chat-target="status"></span> AG-UI
                </div>
            </div>

            <div
                data-agent-chat-target="messages"
                class="flex-1 min-h-0 px-4 py-4 space-y-4 overflow-y-auto"
            >
                <div class="text-center text-sm text-slate-500 dark:text-slate-400 py-8" data-agent-chat-target="placeholder">
                    {{ 'chat.suggestion'|trans }}
                </div>
            </div>

            {# The voice controller only fills the input and submits the form: to the
               agent, a spoken question is a typed one. #}
            <form
                data-controller="voice"
                data-voice-listening-value="{{ 'console.listening'|trans }}"
                data-action="submit->agent-chat#send submit->ag-ui#send agent-chat:answered@document->voice#speak"
                class="border-t border-slate-200 dark:border-slate-800 p-3"
            >
                <div class="flex items-end gap-2">
                    <button
                        type="button"
                        data-voice-target="button"
                        data-action="voice#toggle"
                        title="{{ 'console.talk'|trans }}"
                        class="hidden shrink-0 w-12 h-12 rounded-full items-center justify-center border-2 border-sky-500 text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-950 transition data-[listening]:bg-red-600 data-[listening]:border-red-600 data-[listening]:text-white data-[listening]:animate-pulse"
                    >
                        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="3" width="6" height="11" rx="3"/>
                            <path stroke-linecap="round" d="M5 11a7 7 0 0 0 14 0M12 18v3"/>
                        </svg>
                    </button>

                    <div class="flex-1 flex items-end gap-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-1.5 focus-within:border-sky-500 transition">
                        <textarea
                            data-agent-chat-target="input"
                            data-ag-ui-target="input"
                            data-voice-target="input"
                            data-action="keydown.enter->agent-chat#maybeSend"
                            rows="1"
                            placeholder="{{ 'chat.placeholder'|trans }}"
                            class="flex-1 resize-none bg-transparent px-2 py-1.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none"
                            required
                        ></textarea>
                        <button
                            type="submit"
                            data-agent-chat-target="submit"
                            title="{{ 'chat.send'|trans }}"
                            class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-sky-600 text-white hover:bg-sky-500 disabled:opacity-40 disabled:cursor-not-allowed transition"
                        >
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <p class="mt-2 text-[10px] text-slate-400 dark:text-slate-500 text-center">
                    {{ 'chat.disclaimer'|trans }}
                </p>
            </form>

            {# Server-rendered components with no slot in the log land here (none today:
               every tool call lays one out). #}
            <div data-controller="ag-ui-activities"></div>

            {# Log lines rather than bubbles: what the skipper said… #}
            <template data-agent-chat-target="userTemplate">
                <div class="flex gap-2 text-sm">
                    <span class="mfd-label !mb-0 pt-0.5 text-sky-600 dark:text-sky-400 shrink-0">{{ 'console.skipper'|trans }}</span>
                    <div class="text-slate-900 dark:text-slate-100 whitespace-pre-wrap" data-role="text"></div>
                </div>
            </template>

            {# …what the skipper did on the page, which tells the navigator too… #}
            <template data-agent-chat-target="actionTemplate">
                <div class="flex gap-2 text-sm">
                    <span class="mfd-label !mb-0 pt-0.5 text-sky-600 dark:text-sky-400 shrink-0">{{ 'console.skipper'|trans }}</span>
                    <div class="flex-1 rounded-md border border-dashed border-sky-300 dark:border-sky-800 px-2 py-1 text-slate-600 dark:text-slate-300 italic">
                        <span class="not-italic mr-1">🗺️</span><span data-role="text"></span>
                    </div>
                </div>
            </template>

            {# …and what the navigator answered. #}
            <template data-agent-chat-target="assistantTemplate">
                <div class="border-l-2 border-orange-500 pl-3">
                    {# Text, reasoning, tool calls and activities are appended here in the
                       order their AG-UI events arrive. #}
                    <div class="text-sm" data-role="body"></div>
                </div>
            </template>
        </div>
    </main>
</div>
{% endblock %}
