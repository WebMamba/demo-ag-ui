{# Replaced wholesale by a <turbo-stream> when the agent changes the language:
   translated markup can only be produced by the server, so the browser cannot do it
   by itself. #}
<header id="app-chrome" class="bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="px-4 py-2 flex items-center gap-3">
        <div class="text-xl">⛵</div>
        <h1 class="text-sm font-bold uppercase tracking-[0.2em] text-slate-900 dark:text-slate-100">{{ 'app.title'|trans }}</h1>
        <p class="hidden md:block text-xs text-slate-500 dark:text-slate-400 truncate">{{ 'app.tagline'|trans }}</p>
        <div class="ml-auto flex items-center gap-4 mfd-digits text-sm text-slate-600 dark:text-slate-300" data-controller="clock">
            <span><span class="text-[10px] tracking-wider text-slate-400">UTC</span> <span data-clock-target="time">--:--:--</span></span>
        </div>
    </div>
</header>
